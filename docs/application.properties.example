
# EDA Microservice Discovery System — Configuration Reference
# Copy relevant sections into application.properties and adjust for your env.


spring.application.name=eda-discovery-service
server.port=8080


#   Redis
# Redis is the registry itself, not just a cache. Every replica reads and writes the
# same service records, which is what makes a registration on one replica visible on
# all of them and lets any replica serve any read.
#
# Two Lettuce connections are used:
#   1. Primary (master + replica) — registry reads with ReadFrom.REPLICA_PREFERRED
#   2. Direct master — leader-election keys and pub/sub relay (separate factory)
#
# In Kubernetes: redis-master and redis-replica are ClusterIP service names.
# Locally (Docker Compose): the compose service names are the same.

spring.data.redis.host=redis-master
spring.data.redis.port=6379
spring.data.redis.replica-host=redis-replica
spring.data.redis.replica-port=6379
spring.data.redis.timeout=2000ms


#   Kafka
# Topic: service-events  |  Keyed by service name (per-service ordering)
# Events: SERVICE_REGISTERED, SERVICE_DEREGISTERED, STATUS_CHANGED
#
# The topic is declared by KafkaTopicConfig, not broker auto-created: it is
# log-compacted so a consumer replaying from offset 0 always reconstructs current
# state, however old a service's last event is.

spring.kafka.bootstrap-servers=kafka:9092
spring.kafka.producer.key-serializer=org.apache.kafka.common.serialization.StringSerializer
spring.kafka.producer.value-serializer=org.springframework.kafka.support.serializer.JsonSerializer

# MUST stay false. With type headers on, every record carries
# __TypeId__=com.eda.discovery.model.ServiceEvent, which outranks a consumer's
# configured default type — so any consumer without this module on its classpath
# fails deserialization and stalls on that offset forever. The stream is a JSON
# schema contract; consumers own their own DTOs.
# (Also enforced in code by KafkaProducerConfig, so a config edit cannot break it.)
spring.kafka.producer.properties.spring.json.add.type.headers=false

service-events.topic.name=service-events
service-events.topic.partitions=3


#   Kafka destination naming
# Logical service name → Kafka destinations, derived by convention so services need
# no code change. "service-b" becomes service-b.in / service-b.compensate.
# Consumers get these on every event and resolve names locally, with no HTTP call.

topics.input.suffix=.in
topics.compensation.suffix=.compensate


#   Capability catalog
# Each registered service's OpenAPI document is fetched and parsed into a set of
# operations ("POST /products/{id}/reserve", plus declared operationIds), queryable at
# GET /services/{name}/capabilities and GET /services/{name}/supports?operation=...
# Refresh is leader-gated so three replicas don't all hit every spec endpoint.
# Fetching never happens during registration — a slow spec must not fail a valid
# registration.

capabilities.refresh-interval-ms=60000


#   Health Check
# One replica at a time runs a cycle, guarded by the Redis lock discovery:healthcheck:lock
# (TTL = 3x the interval so it outlives a cycle).
#
# Probing is ADVISORY. The Kubernetes Watch is authoritative for pod-level state; the
# HTTP probe reuses the service's current fencing generation so it can never outrank it.
#
# Status vocabulary (one vocabulary, all writers — see model/ServiceStatus):
#   unknown       registered, nothing observed yet   — not routable
#   healthy       observed ready and serving          — the ONLY routable status
#   not-ready     running but not serving, or probe failing below threshold
#   unavailable   pod gone, or probe failures past the threshold

# How often to run health checks (ms)
health-check.interval-ms=15000

# Retry attempts per check (total attempts = 1 + max-retries)
health-check.max-retries=2

# Consecutive failures before marking a service unavailable
health-check.failure-threshold=3

# HTTP connect/read timeout per attempt (ms) — applied to the probe RestTemplate
health-check.timeout-ms=5000

# Scenario presets:
#
# Development — fast feedback
#   health-check.interval-ms=5000
#   health-check.max-retries=1
#   health-check.failure-threshold=2
#
# Production — stable and tolerant
#   health-check.interval-ms=30000
#   health-check.max-retries=3
#   health-check.failure-threshold=5
#
# Critical services — strict monitoring
#   health-check.interval-ms=10000
#   health-check.max-retries=0
#   health-check.failure-threshold=1


# 	 Leader Election
# Both the global leader key (discovery:leader) and per-partition keys
# (discovery:partition:N:leader) use the same TTL and renewal interval.
# Renewal uses a Lua GET+EXPIRE script (atomic — no race condition).
# Identity is the POD_NAME env var injected via the Kubernetes Downward API.
#
# Failover times:
#   Graceful shutdown (@PreDestroy Lua delete) → < 1 s
#   Hard crash (TTL expiry)                   → <= ttl-seconds

# Redis key TTL in seconds
leader-election.ttl-seconds=10

# Renewal interval in milliseconds (should be < ttl-seconds * 1000 / 3)
leader-election.renewal-interval-ms=3000


#  Partition Configuration
# Services map to partitions via floorMod(hash(serviceName), partition.count)
# (floorMod, not abs(x % n): abs(Integer.MIN_VALUE) is still negative).
# Each partition has its own leader-election key and Kubernetes Watch stream.
# Each partition also has a monotonic generation counter, incremented on every
# leadership change and stamped onto every event as a fencing token — consumers drop
# any status event whose generation is older than the newest one they have applied.
# Increasing partition.count spreads Watch load across more replicas.
# Must match the PARTITION_COUNT env var set on the StatefulSet
# (use configure-cluster.sh to change both at once).

partition.count=3


#  Probes
# /health  — liveness. Process is up and serving HTTP. Dependency-free on purpose:
#            a Redis outage must not make Kubernetes restart every discovery pod.
# /ready   — readiness. Pings Redis. A replica that cannot reach Redis cannot read the
#            registry, so it must stop receiving traffic rather than serve errors.
# The registry lives in Redis, so there is no registry file path to configure.


#  Logging
# Reduce to INFO in production.

logging.level.com.eda.discovery=DEBUG
logging.level.org.springframework.data.redis=WARN
logging.level.org.springframework.kafka=WARN
